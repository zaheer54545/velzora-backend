PORT=3002
NODE_ENV=development

# Local development database
MONGO_URI=mongodb://127.0.0.1:27017/velzora

# Replace with a secure random secret in your local .env
JWT_SECRET=replace_with_a_long_random_secret

# Optional: Configure Cloudinary for persistent image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Configure SMTP for sending OTP emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Store shipping and tax configuration
DEFAULT_SHIPPING_FEE=
FREE_SHIPPING_THRESHOLD=
VAT_RATE=